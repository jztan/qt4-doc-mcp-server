# Docker environment for qt4-doc-mcp-server
#
# Copy to .env.docker and adjust, then start with:
#   docker compose --env-file .env.docker up -d
# (--env-file makes QT_DOC_HTML_PATH and HOST_PORT available for compose
#  interpolation; the file is also loaded into the container via env_file)

# Absolute or repo-relative host path to the Qt doc/html directory.
# Prepare it with: python scripts/prepare_qt48_docs.py --segments 4
QT_DOC_HTML_PATH=./qt4-docs-html

# Host port to publish the server on (the container side is always 8000).
# Use this when port 8000 is already taken on the host.
#HOST_PORT=8000

# Optional overrides (container defaults shown)
#MD_CACHE_SIZE=512
#DEFAULT_MAX_MARKDOWN_LENGTH=20000
#PRECONVERT_MD=false
#PREINDEX_DOCS=true
#MCP_LOG_LEVEL=WARNING
